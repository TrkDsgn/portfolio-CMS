{
  "name": "portfolio-tarik-bouabid",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Portfolio de Tarik Bouabid : site statique généré par Node.js (esbuild + sharp), contenu éditable via Decap CMS (/admin).",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "node scripts/build.mjs",
    "preview": "npm run build && node scripts/preview.mjs",
    "cms": "npx --yes decap-server@3.11.6",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "esbuild": "0.28.2",
    "prettier": "3.10.1",
    "sharp": "0.35.5"
  }
}
